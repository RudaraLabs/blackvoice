# Normalise line endings.
#
# Black Voice ships a shell script and a systemd unit that Linux reads directly.
# A CRLF line ending in install.sh makes the kernel fail with
# "bad interpreter: /usr/bin/env bash^M", which is a confusing way to discover
# that a file was committed from Windows. Storing everything as LF in the
# repository removes the possibility.

* text=auto eol=lf

# Files Linux executes or parses - these must be LF no matter what the
# contributor's core.autocrlf is set to.
*.sh            text eol=lf
*.service       text eol=lf
*.desktop       text eol=lf
install.sh      text eol=lf

# Source and configuration
*.py            text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.txt           text eol=lf
*.svg           text eol=lf

# Binary - never touch these
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.onnx          binary
*.zip           binary

# Keep generated brand assets out of diffs; they are regenerated by
# assets/generate_brand.py rather than edited by hand.
assets/rudralabs-trishul-*.png  binary linguist-generated=true

# Documentation folders should not skew the language statistics.
wiki/**         linguist-documentation=true
